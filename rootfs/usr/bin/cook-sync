#!/bin/sh
# Downloads recipes. Usage: cook-sync <url> [data dir]
#
# <url> points at a plain-text list with one recipe link per line (links can
# be full addresses or relative to the list). Blank lines and lines starting
# with "#" are skipped. If <url> is itself a recipe (starts with "# "), just
# that one recipe is downloaded. Photos a recipe links to with a
# "![text](link)" line (relative to the recipe) are saved next to it, and so
# is <recipe name>.thumb.jpg, the list picture, when the server has one.
# favorites.txt next to the list (recipe file names) is saved as .favorites.
#
# The new set replaces the old one only if at least one recipe downloaded.

URL=$1
DATA=${2:-/data/cook}
IN=$DATA/incoming

fail() { echo "ERR $*"; rm -rf "$IN"; wifi down >/dev/null 2>&1; exit 1; }
trap 'fail "Canceled."' TERM INT

[ -n "$URL" ] || fail "No recipe source is set."

echo "MSG Starting Wi-Fi…"
wifi online || { wifi down >/dev/null 2>&1; exit 1; }

get() { curl -fsSL --connect-timeout 15 --max-time 60 -o "$2" "$1"; }

rm -rf "$IN"
mkdir -p "$IN"
echo "MSG Downloading the recipe list…"
get "$URL" "$IN/.list" || fail "Couldn't download the recipe list. Check the address in Settings."

# strip Windows line endings
sed -i 's/\r$//' "$IN/.list"

name_for() {
    n=${1%%\?*}
    n=${n##*/}
    n=$(printf '%s' "$n" | sed 's/%20/ /g; s/[^A-Za-z0-9 ._-]/_/g')
    [ -n "$n" ] || n=recipe
    case "$n" in *.md|*.txt|*.MD|*.TXT) ;; *) n=$n.md ;; esac
    echo "$n"
}

# a photo keeps its bare file name, cleaned up the same way (cook does this too)
photo_name() {
    n=${1%%\?*}
    n=${n##*/}
    printf '%s' "$n" | sed 's/%20/ /g; s/[^A-Za-z0-9 ._-]/_/g'
}

# resolves link $1 against the folder of address $2
resolve() {
    case "$1" in
        *://*) r=$1 ;;
        /*) r=$(printf '%s' "$2" | sed -E 's#^([A-Za-z]+://[^/]+).*#\1#')$1 ;;
        *) r=${2%%\?*}; r=${r%/*}/$1 ;;
    esac
    printf '%s' "$r" | sed 's/ /%20/g'
}

# downloads the photos recipe file $1 (from address $2) links to, and its thumbnail
photos() {
    t=${2%%\?*}
    t=${t%.*}.thumb.jpg
    tn=$(basename "$1")
    get "$t" "$IN/${tn%.*}.thumb.jpg" 2>/dev/null || rm -f "$IN/${tn%.*}.thumb.jpg"
    sed -n 's/^[[:space:]]*!\[[^]]*](\([^)]*\)).*/\1/p' "$1" | while read -r p; do
        pu=$(resolve "$p" "$2")
        pn=$(photo_name "$pu")
        [ -n "$pn" ] || continue
        get "$pu" "$IN/$pn" || rm -f "$IN/$pn"
    done
}

if head -n 1 "$IN/.list" | grep -q '^# '; then
    f=$IN/$(name_for "$URL")
    mv "$IN/.list" "$f"
    photos "$f" "$URL"
    ok=1
    total=1
else
    grep -v '^[[:space:]]*$' "$IN/.list" | grep -v '^[[:space:]]*#' > "$IN/.links"
    total=$(wc -l < "$IN/.links" | tr -d ' ')
    [ "$total" -gt 0 ] || fail "The recipe list is empty."
    ok=0
    i=0
    while read -r link; do
        i=$((i+1))
        u=$(resolve "$link" "$URL")
        f=$IN/$(name_for "$u")
        echo "MSG Downloading $i of $total…"
        if get "$u" "$f"; then
            ok=$((ok+1))
            photos "$f" "$u"
        fi
    done < "$IN/.links"
    rm -f "$IN/.list" "$IN/.links"
    # favorites.txt next to the list: recipe file names, one per line
    get "$(resolve favorites.txt "$URL")" "$IN/.favorites" 2>/dev/null || rm -f "$IN/.favorites"
fi

[ "$ok" -gt 0 ] || fail "None of the recipes could be downloaded."

rm -rf "$DATA/recipes.old"
[ -d "$DATA/recipes" ] && mv "$DATA/recipes" "$DATA/recipes.old"
mv "$IN" "$DATA/recipes"
rm -rf "$DATA/recipes.old"
sync
wifi down >/dev/null 2>&1

if [ "$ok" -eq "$total" ]; then
    echo "DONE Downloaded $ok recipes."
else
    echo "DONE Downloaded $ok of $total recipes. Some links didn't work."
fi
